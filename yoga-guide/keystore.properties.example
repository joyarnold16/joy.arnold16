# Copy to keystore.properties (git-ignored) and fill in real values.
# The keystore itself belongs at app/release.keystore, also git-ignored.
#
#   keytool -genkeypair -v -keystore app/release.keystore -alias yogaguide \
#           -keyalg RSA -keysize 2048 -validity 10000
#
storePassword=changeme
keyAlias=yogaguide
keyPassword=changeme
