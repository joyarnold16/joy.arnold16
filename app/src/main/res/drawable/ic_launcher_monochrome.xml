<?xml version="1.0" encoding="utf-8"?>
<!-- Themed-icon silhouette. The colour icon is a scene - a worker, a lit
     charge and a blast - and a scene cannot survive being flattened to one
     colour, so this takes the single most legible object out of it: the
     charge, with its fuse lit.
     108dp canvas; every point is kept inside the 18..90 safe box so no mask
     can clip it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="?attr/colorControlNormal">
    <!-- body -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M40,56 L68,56 A6,6 0 0 1 74,62 L74,80 A6,6 0 0 1 68,86 L40,86 A6,6 0 0 1 34,80 L34,62 A6,6 0 0 1 40,56 Z" />
    <!-- collar the fuse comes out of -->
    <path android:fillColor="#FFFFFF" android:pathData="M49,49 L59,49 L59,56 L49,56 Z" />
    <!-- fuse -->
    <path android:strokeColor="#FFFFFF" android:strokeWidth="4"
        android:strokeLineCap="round" android:fillColor="#00000000"
        android:pathData="M57,50 C66,45 63,38 71,34" />
    <!-- spark -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M72,33 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
</vector>
